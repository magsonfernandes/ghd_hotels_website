## Server (Express) settings
PORT=8788

## Where contact/career emails are delivered
MAILBOX=test@ghdhotels.in

## Optional: restrict CORS to specific origins (comma-separated).
## Leave empty for permissive (useful during development).
## When using the admin pricing portal from a different origin, list it here.
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com,https://admin.your-domain.com

## Admin pricing portal
## Shared bearer token that protects /api/admin/rates. If unset, the admin
## routes respond with 503 and writes are refused; the public site keeps
## working using the last saved data/rates.json (or the seeded defaults).
ADMIN_TOKEN=__SET_THIS_ON_THE_SERVER__

## SMTP (company mail server)
SMTP_HOST=mail.ghdhotels.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=test@ghdhotels.in
SMTP_PASS=__SET_THIS_ON_THE_SERVER__

