## Server (Express) settings
PORT=8788

## Where contact/career emails are delivered
MAILBOX=test@ghdhotels.in

## Optional: restrict CORS to specific origins (comma-separated).
## Leave empty for permissive (useful during development).
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

## SMTP (company mail server)
SMTP_HOST=mail.ghdhotels.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=test@ghdhotels.in
SMTP_PASS=__SET_THIS_ON_THE_SERVER__

